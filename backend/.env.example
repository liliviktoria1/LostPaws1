# Server Configuration
PORT=8080
NODE_ENV=development
FRONTEND_URL=http://localhost:3005

# Auth Configuration
JWT_SECRET=your_super_secret_random_string_here

# Database Configuration (PostgreSQL)
# Use DATABASE_URL for a single connection string (recommended for Neon/Render)
# Or use individual parameters below
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require
DB_NAME=lost_paws_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# Google AI Configuration (Gemini)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Email Configuration (SendGrid - Recommended for Production/Render)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=verified_sender@yourdomain.com

# Email Configuration (SMTP - Will be blocked on Render)
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
